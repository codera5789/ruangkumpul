# URL situs publik (wajib diisi untuk metadata, sitemap, dan redirect OAuth produksi)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kredensial Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Opsional — hanya dipakai di server untuk penghapusan akun penuh (UU PDP).
# Jika dikosongkan, hapus akun otomatis beralih ke mode anonimisasi + hapus data lewat RLS.
# JANGAN PERNAH beri prefiks NEXT_PUBLIC_ pada key ini.
SUPABASE_SERVICE_ROLE_KEY=
